# ════════════════════════════════════════
# QX Native Pro Config - Quantumult X Native Configuration
# Version: 8.2 Enhanced Edition
# Description: Quantumult X 原生 Pro 版本增强配置
# ════════════════════════════════════════

[rewrite_local]

# ════════════════════════════════════════
# 📱 微信 WeChat Pro
# ════════════════════════════════════════
^https?:\/\/api\.weixin\.qq\.com\/cgi-bin\/appmsg script-request-body https://ws.wenn.in/main/Scripts/WeChat.js, tag=微信朋友圈净化
^https?:\/\/new\.weixin\.qq\.com\/mp\/getappmsgad script-request-body https://ws.wenn.in/main/Scripts/WeChat.js, tag=微信公众号文章净化
^https?:\/\/channels\.video\.qq\.com script-request-body https://ws.wenn.in/main/Scripts/WeChat.js, tag=微信视频号净化
^https?:\/\/app\.weixin\.qq\.com\/cgi-bin script-request-body https://ws.wenn.in/main/Scripts/WeChat.js, tag=微信小程序净化
# ⚠️ 链接直连需要脚本提取目标URL，以下为占位，需自行补充脚本
# ^https?:\/\/link\.zhihu\.com\/ script-request-header https://example.com/zhihu-link.js, tag=知乎链接直连
# ^https?:\/\/url\.me\.qq\.com\/ script-request-header https://example.com/qq-link.js, tag=QQ链接直连

# ════════════════════════════════════════
# 💰 支付宝 Alipay Pro
# ════════════════════════════════════════
^https?:\/\/sdkopen\.vip\.alipay\.com\/splash script-request-body https://ws.wenn.in/main/Scripts/Alipay.js, tag=支付宝开屏净化
^https?:\/\/h5api\.alipay\.com\/gateway script-request-body https://ws.wenn.in/main/Scripts/Alipay.js, tag=支付宝首页净化
^https?:\/\/transfer\.alipay\.com\/activity script-request-body https://ws.wenn.in/main/Scripts/Alipay.js, tag=转账页营销清理
^https?:\/\/fund\.fundmate\.alibaba\.com script-request-body https://ws.wenn.in/main/Scripts/Alipay.js, tag=理财推广清理
# ⚠️ header-replace-request 只能修改已存在的请求头，添加新请求头需使用 script-request-header
^https?:\/\/member\.service\.alipay\.com header-replace-request X-Member-Level user-custom, tag=支付宝会员增强

# ════════════════════════════════════════
# 🎬 腾讯视频 Tencent Video Pro
# ════════════════════════════════════════
^https?:\/\/ads\.api\.tencent\.com\/splash script-request-body https://ws.wenn.in/main/Scripts/TencentVideo.js, tag=腾讯视频开屏过滤
^https?:\/\/att\.video\.qcloud\.com script-request-body https://ws.wenn.in/main/Scripts/TencentVideo.js, tag=视频推荐清除
^https?:\/\/pay\.video\.qcloud\.com header-replace-request X-Vip-Status true, tag=腾讯视频VIP
^https?:\/\/api\.web\.vv\.qq\.com script-request-body https://ws.wenn.in/main/Scripts/TencentVideo.js, tag=4K画质解锁

# ════════════════════════════════════════
# 🥝 爱奇艺 iQIYI Pro
# ════════════════════════════════════════
^https?:\/\/ads\.api\.iqiyi\.com script-request-body https://ws.wenn.in/main/Scripts/Iqiyi.js, tag=爱奇艺开屏去除
^https?:\/\/feed\.pgc\.iqiyi\.com script-request-body https://ws.wenn.in/main/Scripts/Iqiyi.js, tag=爱奇艺首页清理
^https?:\/\/data\.v\.iqiyi\.com script-request-body https://ws.wenn.in/main/Scripts/Iqiyi.js, tag=跳过片头广告
^https?:\/\/m\.api\.cn\.iqiyi\.com script-request-body https://ws.wenn.in/main/Scripts/Iqiyi.js, tag=去除片尾推广
^https?:\/\/player\.api\.iqiyi\.com script-request-body https://ws.wenn.in/main/Scripts/Iqiyi.js, tag=4K/UHD解锁

# ════════════════════════════════════════
# 🛒 淘宝天猫 Taobao Tmall Pro
# ════════════════════════════════════════
^https?:\/\/ads\.api\.taobao\.com script-request-body https://ws.wenn.in/main/Scripts/Taobao.js, tag=淘宝开屏移除
^https?:\/\/h5\.msearch\.taobao\.com script-request-body https://ws.wenn.in/main/Scripts/Taobao.js, tag=搜索净化
^https?:\/\/cart\.taobao\.com script-request-body https://ws.wenn.in/main/Scripts/Taobao.js, tag=购物车净化
^https?:\/\/vip\.service\.taobao\.com header-replace-request X-Vip-Level 88, tag=淘宝88VIP
^https?:\/\/coupon\.member\.alipay\.com script-request-body https://ws.wenn.in/main/Scripts/Taobao.js, tag=88VIP优惠券解锁

# ════════════════════════════════════════
# 🍪 小红书 XiaoHongShu Pro
# ════════════════════════════════════════
^https?:\/\/home-api\.xiaohongshu\.com script-request-body https://ws.wenn.in/main/Scripts/XiaoHongShu.js, tag=小红书开屏过滤
^https?:\/\/api\.xiaohongshu\.com script-request-body https://ws.wenn.in/main/Scripts/XiaoHongShu.js, tag=信息流净化
^https?:\/\/sns-img-bd\.xhscdn\.com script-request-body https://ws.wenn.in/main/Scripts/XiaoHongShu.js, tag=图片去水印
^https?:\/\/sns-video-bd\.xhscdn\.com script-request-body https://ws.wenn.in/main/Scripts/XiaoHongShu.js, tag=视频去水印

# ════════════════════════════════════════
# 🧧 拼多多 Pinduoduo Pro
# ════════════════════════════════════════
^https?:\/\/ads\.api\.pinduoduo\.com script-request-body https://ws.wenn.in/main/Scripts/Pinduoduo.js, tag=拼多多开屏清理
^https?:\/\/mobile\.yangkeduo\.com script-request-body https://ws.wenn.in/main/Scripts/Pinduoduo.js, tag=首页纯净化
^https?:\/\/search\.api\.pinduoduo\.com script-request-body https://ws.wenn.in/main/Scripts/Pinduoduo.js, tag=搜索词净化
^https?:\/\/subsidy\.api\.pinduoduo\.com script-request-body https://ws.wenn.in/main/Scripts/Pinduoduo.js, tag=百亿补贴优化

# ════════════════════════════════════════
# 💳 云闪付 SunShuFu Pro
# ════════════════════════════════════════
^https?:\/\/m\.unionpay\.com script-request-body https://ws.wenn.in/main/Scripts/SunShuFu.js, tag=云闪付开屏清理
^https?:\/\/coupon\.unionpay\.com script-request-body https://ws.wenn.in/main/Scripts/SunShuFu.js, tag=优惠券弹窗拦截
^https?:\/\/bankoffer\.unionpay\.com script-request-body https://ws.wenn.in/main/Scripts/SunShuFu.js, tag=银行专属优惠解锁

# ════════════════════════════════════════
# 🚗 滴滴出行 DiDi Pro
# ════════════════════════════════════════
^https?:\/\/ads\.didiglobal\.com script-request-body https://ws.wenn.in/main/Scripts/DiDi.js, tag=滴滴开屏过滤
^https?:\/\/order\.didi\.cn script-request-body https://ws.wenn.in/main/Scripts/DiDi.js, tag=订单页营销清理
^https?:\/\/points\.didi\.cn header-replace-request X-DPoints premium, tag=滴滴会员优化

# ════════════════════════════════════════
# 🔧 钉钉 DingTalk Pro
# ════════════════════════════════════════
^https?:\/\/api\.dingtalk\.com script-request-body https://ws.wenn.in/main/Scripts/DingTalk.js, tag=消息净化
^https?:\/\/oa\.dingtalk\.com script-request-body https://ws.wenn.in/main/Scripts/DingTalk.js, tag=工作台推荐清理
^https?:\/\/nls-gateway\.cn-shanghai\.aliyuncs\.com header-replace-request X-Ding-Assist optimize, tag=钉钉智能助手优化

# ════════════════════════════════════════
# 📊 知乎 Zhihu Pro
# ════════════════════════════════════════
# ⚠️ 原配置缺少域名，已修正
^https?:\/\/.*\.zhihu\.com\/commercial_api\/real_time_launch_v2 script-request-body https://ws.wenn.in/main/Scripts/Zhihu.js, tag=知乎开屏清理
^https?:\/\/.*\.zhihu\.com\/topstory\/recommend script-request-body https://ws.wenn.in/main/Scripts/Zhihu.js, tag=推荐列表净化
^https?:\/\/.*\.zhihu\.com\/commercial_api\/app_float_layer script-request-body https://ws.wenn.in/main/Scripts/Zhihu.js, tag=悬浮框清理

# ════════════════════════════════════════
# 📺 B站 Bilibili Pro
# ════════════════════════════════════════
^https?:\/\/live-bd\.biliapi\.net script-request-body https://ws.wenn.in/main/Scripts/Bilibili.js, tag=B站开屏阻止
^https?:\/\/api\.bilibili\.com script-request-body https://ws.wenn.in/main/Scripts/Bilibili.js, tag=直播净化
# ⚠️ 原配置缺少域名，已修正
^https?:\/\/api\.bilibili\.com\/pgc\/player\/web script-request-body https://ws.wenn.in/main/Scripts/Bilibili.js, tag=1080P解锁

# ════════════════════════════════════════
# ☁️ 百度网盘 Baidu Pan Pro
# ════════════════════════════════════════
^https?:\/\/pcs\.baidu\.com header-replace-request X-Extra-Info vip_accelerate%3Dtrue, tag=百度网盘加速
^https?:\/\/api\.netdisk\.com script-request-body https://ws.wenn.in/main/Scripts/BdPan.js, tag=倍速播放解锁

# ════════════════════════════════════════
# 🌟 浏览器 Safari WebView Pro
# ════════════════════════════════════════
^https?:\/\/.*inapps\.com script-request-body https://ws.wenn.in/main/Scripts/BrowserClean.js, tag=WebView广告拦截
^https?:\/\/render\.alipay\.com script-request-body https://ws.wenn.in/main/Scripts/BrowserClean.js, tag=支付宝WebView净化
^https?:\/\/count\.appannie\.com script-request-body https://ws.wenn.in/main/Scripts/BrowserClean.js, tag=统计追踪拦截

# ════════════════════════════════════════
# 🎵 网易云音乐 NetEase Music Pro
# ════════════════════════════════════════
^https?:\/\/interface(\d)?\.music\.163\.com script-request-body https://ws.wenn.in/main/Mirror/netease.adblock.js, tag=框架净化

# ════════════════════════════════════════
# 🗺️ 高德地图 Amap Pro
# ════════════════════════════════════════
^https?:\/\/rest\.amap\.com script-request-body https://ws.wenn.in/main/Scripts/Amap.js, tag=定位净化

# ════════════════════════════════════════
# 🚌 淘票票 TaoPiaoPiao Pro
# ════════════════════════════════════════
^https?:\/\/acs\.m\.taobao\.com\/gw.*mtop.*film.*life.*aristotle url reject-200, tag=淘票票首页清理
^https?:\/\/acs\.m\.taobao\.com\/gw.*mtop.*film.*mtopadvertiseapi.*queryloadingbanner url reject-200, tag=淘票票开屏拦截
